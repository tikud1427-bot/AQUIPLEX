# AQUIPLEX production-safe configuration template.
# Never commit real API keys or DATABASE_URL values.

# Core
AQUA_BRAIN=on
AQUA_PIC=on
AQUA_EMBEDDINGS=on

# Understanding (E6) — enable only after the measured extractor gate has
# been reproduced with the production provider/model configuration.
AQUA_E6=off
AQUA_E6_COMMIT=off
AQUA_E6_EXTRACTOR_VERSION=e6-v1
AQUA_E6_PROVIDER=groq
AQUA_E6_MODEL=openai/gpt-oss-120b

# World-model retrieval/context — staged rollout gates.
AQUA_CONTEXT_V2=off
AQUA_RETRIEVAL_V3=off
AQUA_CROSS_ENCODER=off
AQUA_CROSS_ENCODER_POOL=32
AQUA_CROSS_ENCODER_BLEND=0.20
AQUA_CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Canonical dense retrieval model identity.
AQUA_EMBED_MODEL=gemini-embedding-001
AQUA_EMBED_DIM=768

# Persistence / owner isolation.
# Set these in the deployment secret manager, not in source control.
# DATABASE_URL=postgres://...
