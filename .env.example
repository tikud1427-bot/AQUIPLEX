# AQUIPLEX environment — NAMES ONLY. Copy to .env and fill in. Never commit .env
# (.gitignore ignores .env and .env.*, except this file). Values here are
# placeholders; a real value in this file is a leak. Rotation steps for every
# secret below: SECURITY_ROTATION_CHECKLIST.md.

# ── Core platform (required) ──
NODE_ENV=production
PORT=3000
APP_URL=<https://your-domain>
MONGO_URI=<mongodb+srv://user:password@cluster/db>
SESSION_SECRET=<long random string — rotating it signs everyone out>
ALLOWED_ORIGINS=<https://your-domain>

# ── Google sign-in ──
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<secret>
# GOOGLE_CALLBACK_URL=        GOOGLE_LINK_CALLBACK_URL=        GOOGLE_REAUTH_CALLBACK_URL=

# ── Payments (Razorpay) ──
RAZORPAY_KEY_ID=<rzp_live_...>
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<webhook secret>

# ── Email (verification links) ──
MAIL_TRANSPORT=<resend|log>
MAIL_FROM=<AQUIPLEX <no-reply@your-domain>>
RESEND_API_KEY=<key>

# ── Credits and plans ──
FREE_DAILY_CREDITS=200
UNLIMITED_USER_EMAILS=<comma-separated emails; not a secret, but do not publish>
# STARTER_PACK_PRICE= STARTER_PACK_CREDITS= GROWTH_PACK_PRICE= GROWTH_PACK_CREDITS=
# PRO_PACK_PRICE= PRO_PACK_CREDITS= MAX_PACK_PRICE= MAX_PACK_CREDITS=
# FREE_LIMIT_IMAGE= FREE_LIMIT_CODE= FREE_LIMIT_SEARCH= FREE_LIMIT_WEBSITE= FREE_LIMIT_WEBEDIT=
# ADMIN_PASSWORD=<only if the admin surface is enabled>

# ── Search ──
# SERPER_API_KEY=<key>   SERPER_API_KEY_1..N=<key>   TAVILY_API_KEY_1..N=<key>

# ── Hugging Face ──
# HF_TOKEN=<token>

# ── World Model store (optional; unset = legacy read) ──
# DATABASE_URL=<postgres://user:password@host:5432/db>

# ── Product analytics ──
# AQUA_PRODUCT_EVENTS=off   # disables content-free product events

# Server-only Android App Links configuration.
# Never put private signing keys or provider credentials here.
PLAY_APP_SIGNING_SHA256=<PLAY_APP_SIGNING_SHA256>

# Optional production backends (E12) — unset = local defaults. See docs/OBSERVABILITY.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=<https://collector.example:4318>
# OTEL_EXPORTER_OTLP_HEADERS=<x-api-key=...>
# OTEL_SERVICE_NAME=aquiplex
# AQUA_ERROR_WEBHOOK_URL=<https://hooks.example/errors>
# AQUA_ERROR_WEBHOOK_TOKEN=<token>
# AQUA_RATE_LIMIT_REDIS_URL=<rediss://user:password@host:6379/0>

# AI provider key pools (aqua/src/providers/keyPool.cjs) — names only; real keys
# live in the root .env. BOTH the engine and services/ai.client.js read BOTH
# spellings: the unnumbered key and any number of numbered slots (_1.._N, sparse
# is fine, slot 10 sorts after 9). Identical values are used once. A changed
# value takes effect on restart (dotenv loads once at boot). Health of a key is
# "unknown" until a real call or `cd aqua && npm run doctor:providers -- --probe`
# proves it; `npm run doctor:providers` alone is offline. Keys from ONE Google
# project share that project's quota — more keys there is not more quota.
# GEMINI_API_KEY=<key>          (legacy spelling Gemini_API_Key is also read)
# GEMINI_KEY_1=<key>  …  GEMINI_KEY_N=<key>
# GROQ_API_KEY=<key>            GROQ_API_KEY_1=<key>  …  GROQ_API_KEY_N=<key>
# OPENROUTER_API_KEY=<key>      OPENROUTER_API_KEY_1=<key>  …  OPENROUTER_API_KEY_N=<key>
# AQUA_PROVIDER_MAX_KEYS_PER_MODEL=3   # non-rejected key attempts per model per request
# AQUA_PROVIDER_MAX_KEY_ATTEMPTS=8     # non-rejected key attempts per provider call
# AQUA_PROVIDER_KEY_REJECT_TTL_MS=     # unset = a 401/403 key stays quarantined until restart

# NVIDIA provider (aqua/src/providers/nvidia.js, services/ai.client.js) — names only;
# the real keys live in the root .env, never here. Any number of numbered slots.
# NVIDIA_API_KEY_1=<key>
# NVIDIA_API_KEY_2=<key>
# NVIDIA_DEFAULT_MODEL=openai/gpt-oss-20b      # default; do not use the deprecated 120b free endpoint
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # override only for a gateway / self-hosted NIM
# AQUA_PROVIDER_PREFER=nvidia                  # controlled rollout: rank nvidia first (unset = score ranking)

# ── World Model read mode (E10 cutover, 2026-10-06) ──
# unset/auto = canonical-authoritative (default): the canonical World Model answers;
#              legacy identity/regex memory only fills gaps it does not contradict
# on         = canonical only (no legacy user memory at all)
# off        = legacy rollback (the pre-cutover answer context)
# AQUA_CANONICAL_READ=auto

# ── Proactive intelligence + bounded actions (Phase 4/5, 2026-10-06) ──
# AQUA_PROACTIVE=off                    # ON by default (eval/suites/proactive-core); off = rollback
# AQUA_PROACTIVE_INTERVAL_MS=3600000    # worker periodic scan (0 = change-triggered only)
