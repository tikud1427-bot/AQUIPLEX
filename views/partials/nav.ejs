<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<script>document.documentElement.classList.add('js');</script>

<%# Fonts load here for every view that does not load them itself. A view
    that already has the <link> in its own <head> — where it belongs — opts
    out with include("partials/nav", { pxFonts: false }). %>
<% if (typeof pxFonts === "undefined" || pxFonts !== false) { %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@450;550;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
<% } %>

<%# Brand hierarchy: the wordmark is always the company (AQUIPLEX); the
    product (Aqua AI) is a destination of its own, never the logo. %>
<header class="px-nav">
  <div class="px-nav-inner">

    <a href="/" class="px-nav-logo" aria-label="AQUIPLEX home">
      <img src="/logo/logo.png" alt="" width="22" height="22">
      <span class="px-nav-wordmark">AQUIPLEX</span>
    </a>

    <nav class="px-nav-links" aria-label="Main navigation">
      <a href="/landing#aqua" class="px-nav-link">Aqua AI</a>
      <a href="/pricing" class="px-nav-link">Pricing</a>
      <div class="px-nav-more" id="pxNavMore">
        <button type="button" onclick="pxToggleMore(event)" aria-expanded="false" aria-controls="pxMoreDropdown" aria-haspopup="true">
          Company
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="px-nav-dropdown" id="pxMoreDropdown">
          <a href="/about">About AQUIPLEX</a>
          <a href="/founders">Founders</a>
          <a href="/blogs">Blog</a>
        </div>
      </div>
    </nav>

    <div class="px-nav-actions">
      <% if (typeof user !== "undefined" && user) { %>

        <% if (user.plan && user.plan !== 'free') { %>
          <a href="/billing" class="px-nav-plan plan-<%= user.plan %>"><%= user.plan.toUpperCase() %></a>
        <% } else { %>
          <a href="/pricing" class="px-nav-plan">Upgrade</a>
        <% } %>

        <a href="/aqua" class="px-btn px-btn-primary px-btn-sm">Open Aqua</a>

        <div class="px-nav-user">
          <button class="px-nav-avatar-btn" onclick="toggleUserMenu(event)" aria-label="Account menu" aria-expanded="false" aria-controls="navUserDropdown" aria-haspopup="true">
            <%= (user.username || user.email || 'U')[0].toUpperCase() %>
          </button>
          <div class="px-nav-user-dropdown" id="navUserDropdown">
            <div class="px-nav-user-meta">
              <div class="px-nav-user-email"><%= user.email || user.username %></div>
            </div>
            <div class="px-nav-user-planrow">
              <span class="px-badge <%= (user.plan && user.plan !== 'free') ? 'px-badge-accent' : '' %>"><%= (user.plan || 'free').toUpperCase() %></span>
            </div>
            <div class="px-nav-divider"></div>
            <a href="/billing" class="px-nav-item">Billing &amp; credits</a>
            <a href="/wallet" class="px-nav-item">Wallet</a>
            <a href="/pricing" class="px-nav-item">Upgrade plan</a>
            <div class="px-nav-divider"></div>
            <a href="/logout" class="px-nav-item">Log out</a>
          </div>
        </div>

      <% } else { %>
        <a href="/login" class="px-nav-link px-nav-login">Log in</a>
        <a href="<%= PLAY_STORE_URL %>" class="px-btn px-btn-primary px-btn-sm" target="_blank" rel="noopener noreferrer" aria-label="Download Aqua AI on Google Play (opens in a new tab)">
          <span class="px-nav-cta-long">Download Aqua AI</span><span class="px-nav-cta-short">Download</span>
        </a>
      <% } %>

      <button class="px-nav-burger" onclick="toggleMenu()" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </div>

  </div>

  <div class="px-nav-mobile" id="mobileMenu">
    <% if (typeof user !== "undefined" && user) { %>
      <a href="/aqua" class="px-btn px-btn-primary">Open Aqua</a>
      <% if (user.plan === 'free' || !user.plan) { %>
        <a href="/pricing" class="px-btn px-btn-secondary">Upgrade plan</a>
      <% } else { %>
        <a href="/billing" class="px-btn px-btn-secondary"><%= (user.plan || 'free').toUpperCase() %> plan &middot; Billing</a>
      <% } %>
    <% } else { %>
      <a href="<%= PLAY_STORE_URL %>" class="px-btn px-btn-primary" target="_blank" rel="noopener noreferrer">Download Aqua AI &middot; Google Play</a>
    <% } %>

    <div class="px-nav-mobile-divider"></div>
    <a href="/landing#aqua">Aqua AI</a>
    <a href="/pricing">Pricing</a>
    <a href="/about">About AQUIPLEX</a>
    <a href="/founders">Founders</a>
    <a href="/blogs">Blog</a>
    <div class="px-nav-mobile-divider"></div>
    <% if (typeof user !== "undefined" && user) { %>
      <a href="/logout">Log out</a>
    <% } else { %>
      <a href="/login">Log in</a>
      <a href="/signup">Use Aqua on the web</a>
    <% } %>
  </div>
</header>

<script>
function toggleMenu() {
  var menu = document.getElementById("mobileMenu");
  var toggle = document.querySelector(".px-nav-burger");
  if (!menu) return;
  var isOpen = menu.classList.toggle("open");
  document.body.classList.toggle("px-menu-open", isOpen);
  if (toggle) toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
}
function toggleUserMenu(e) {
  e.stopPropagation();
  var dd = document.getElementById("navUserDropdown");
  if (!dd) return;
  var isOpen = dd.classList.toggle("open");
  e.currentTarget.setAttribute("aria-expanded", isOpen ? "true" : "false");
}
function pxToggleMore(e) {
  e.stopPropagation();
  var wrap = document.getElementById("pxNavMore");
  if (!wrap) return;
  var isOpen = wrap.classList.toggle("open");
  e.currentTarget.setAttribute("aria-expanded", isOpen ? "true" : "false");
}
document.addEventListener("click", function (e) {
  var menu = document.getElementById("mobileMenu");
  var toggle = document.querySelector(".px-nav-burger");
  // Close on a click outside the menu, or on one of its links: an in-page
  // anchor (/landing#aqua) does not navigate away, so it would stay open.
  var followedLink = menu && menu.contains(e.target) && e.target.closest("a");
  if (menu && menu.classList.contains("open") && toggle && !toggle.contains(e.target) && (!menu.contains(e.target) || followedLink)) {
    menu.classList.remove("open");
    document.body.classList.remove("px-menu-open");
    toggle.setAttribute("aria-expanded", "false");
  }
  var dd = document.getElementById("navUserDropdown");
  if (dd && dd.classList.contains("open") && !dd.contains(e.target) && !e.target.closest(".px-nav-avatar-btn")) {
    dd.classList.remove("open");
  }
  var more = document.getElementById("pxNavMore");
  if (more && more.classList.contains("open") && !more.contains(e.target)) {
    more.classList.remove("open");
    var btn = more.querySelector("button");
    if (btn) btn.setAttribute("aria-expanded", "false");
  }
});
document.addEventListener("keydown", function (e) {
  if (e.key !== "Escape") return;
  ["mobileMenu", "navUserDropdown", "pxNavMore"].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.classList.remove("open");
  });
  document.body.classList.remove("px-menu-open");
  document.querySelectorAll('[aria-expanded="true"]').forEach(function (b) { b.setAttribute("aria-expanded", "false"); });
});
</script>
