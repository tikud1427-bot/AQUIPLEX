<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>AQUIPLEX — AI that understands your world · Meet Aqua AI</title>

    <meta name="description" content="AQUIPLEX is an AI company building context-aware AI. Aqua AI, our personal thinking system for Android and the web, keeps the context you share so you can think, decide and plan without starting over.">
    <meta name="author" content="AQUIPLEX">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="theme-color" content="#0b0e12" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)">

    <link rel="canonical" href="https://aquiplex.com/" />

    <link rel="icon" href="/logo/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="48x48" href="/logo/favicon-48x48.png">
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png">
    <link rel="manifest" href="/logo/site.webmanifest">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="AQUIPLEX">
    <meta property="og:title" content="AQUIPLEX — AI that understands your world">
    <meta property="og:description" content="AQUIPLEX builds Aqua AI, a personal thinking system that keeps the context you share, so you can start where you left off.">
    <meta property="og:url" content="https://aquiplex.com/">
    <meta property="og:image" content="https://aquiplex.com/og/og-cover.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="AQUIPLEX — AI that understands your world. Meet Aqua AI.">
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="AQUIPLEX — AI that understands your world">
    <meta name="twitter:description" content="Meet Aqua AI, the personal thinking system from AQUIPLEX. Stop rebuilding context. Start where you left off.">
    <meta name="twitter:image" content="https://aquiplex.com/og/og-cover.png">
    <meta name="twitter:image:alt" content="AQUIPLEX — AI that understands your world. Meet Aqua AI.">

    <%# Structured data states only what this repository can verify: the
        company, its public profiles (the same ones the footer links), and
        the product with its real distribution channels. No founding date,
        ratings or feature claims beyond what the page itself says. %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://aquiplex.com/#organization",
          "name": "AQUIPLEX",
          "url": "https://aquiplex.com/",
          "logo": "https://aquiplex.com/logo/logo.png",
          "description": "AQUIPLEX is an AI company building context-aware AI. Its product is Aqua AI, a personal thinking system.",
          "sameAs": [
            "https://www.instagram.com/aquiplex",
            "https://www.linkedin.com/in/aquiplex-33b3a43bb",
            "https://x.com/aquiplex15626"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://aquiplex.com/#website",
          "url": "https://aquiplex.com/",
          "name": "AQUIPLEX",
          "publisher": { "@id": "https://aquiplex.com/#organization" }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://aquiplex.com/#aqua",
          "name": "Aqua AI",
          "image": "https://aquiplex.com/logo/aqua-ai-512.png",
          "applicationCategory": "ProductivityApplication",
          "operatingSystem": "Android, Web",
          "downloadUrl": "<%= PLAY_STORE_URL %>",
          "installUrl": "<%= PLAY_STORE_URL %>",
          "description": "Aqua AI is a personal thinking system from AQUIPLEX. It keeps the context you share — projects, decisions and documents — and uses it in later conversations.",
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "description": "Free credits every day. No card required." },
          "publisher": { "@id": "https://aquiplex.com/#organization" }
        }
      ]
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@450;550;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/platform.css">
  </head>

  <body class="px-page px-lp">

    <a href="#main" class="px-skip">Skip to content</a>

    <%- include("partials/nav", { pxFonts: false }) %>

    <main id="main">

      <!-- ═══ 1 · HERO — company, product, and the one action ═══ -->
      <section class="px-hero" aria-labelledby="hero-title">
        <div class="px-container px-hero-grid">
          <div class="px-hero-copy">
            <p class="px-kicker">AQUIPLEX &middot; Introducing Aqua AI</p>
            <h1 id="hero-title">AI that understands your world.</h1>
            <p class="px-hero-lead">
              AQUIPLEX is building context-aware AI. <strong>Aqua AI</strong> is our personal
              thinking system: it keeps the context you share &mdash; your projects, decisions
              and documents &mdash; so you can think, decide and plan without starting from
              scratch every time.
            </p>
            <div class="px-hero-ctas">
              <a href="<%= PLAY_STORE_URL %>" class="px-btn px-btn-primary px-btn-lg px-dl" target="_blank" rel="noopener noreferrer" aria-label="Download Aqua AI on Google Play (opens in a new tab)">
                <svg class="px-dl-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="px-dl-label"><span>Download Aqua AI</span><span class="px-dl-sub">Android &middot; Google Play</span></span>
              </a>
              <a href="#aqua" class="px-link px-link-arrow">How Aqua works</a>
            </div>
            <p class="px-hero-meta">Free to start, with credits every day. Prefer a browser? <a href="/signup" class="px-link-inline">Use Aqua on the web</a>.</p>
          </div>

          <%# The phone shows Aqua's real opening message, word for word from
              aqua-frontend/src/pages/IntroPage.tsx. It is written, not
              generated, so it is the same for everyone — which is what makes
              it honest to show here. Keep the two in sync. %>
          <figure class="px-hero-visual">
            <div class="px-phone">
              <div class="px-phone-screen">
                <div class="px-phone-bar" aria-hidden="true">
                  <span class="px-phone-app"><img src="/logo/aqua-ai-192.png" alt="" width="18" height="18"> Aqua</span>
                  <span class="px-phone-dot"></span>
                </div>
                <div class="px-phone-body">
                  <p class="px-phone-hi">Hi &mdash; I&rsquo;m Aqua.</p>
                  <p>I work a bit differently from most assistants. Instead of starting every conversation from scratch, I spend a few minutes understanding your world, so I&rsquo;m actually useful later.</p>
                  <p class="px-phone-ask">So &mdash; what are you working on at the moment?</p>
                </div>
                <div class="px-phone-input" aria-hidden="true">
                  <span>Message AQUA&hellip;</span>
                  <span class="px-phone-send"></span>
                </div>
              </div>
            </div>
            <figcaption>Aqua&rsquo;s actual first message to every new user.</figcaption>
          </figure>
        </div>
      </section>

      <!-- ═══ 2 · COMPANY → PRODUCT — the hierarchy, stated once and plainly ═══ -->
      <section class="px-rel" aria-labelledby="rel-title">
        <div class="px-container">
          <h2 id="rel-title" class="px-rel-title px-reveal">One company. One product.</h2>
          <div class="px-rel-grid px-reveal">
            <div class="px-rel-cell">
              <p class="px-rel-role">The company</p>
              <p class="px-rel-name"><img src="/logo/logo.png" alt="" width="32" height="32" class="px-rel-mark">AQUIPLEX</p>
              <p class="px-rel-desc">An AI company building toward the world&rsquo;s most context-aware AI.</p>
            </div>
            <div class="px-rel-link" aria-hidden="true"><span>builds</span></div>
            <div class="px-rel-cell is-product">
              <p class="px-rel-role">The product</p>
              <p class="px-rel-name"><img src="/logo/aqua-ai-192.png" alt="" width="32" height="32" class="px-rel-mark">Aqua AI</p>
              <p class="px-rel-desc">A personal thinking system that brings that vision to your phone and your browser.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 3 · THE PROBLEM ═══ -->
      <section class="px-lp-sec" aria-labelledby="problem-title">
        <div class="px-container">
          <div class="px-lp-head px-reveal">
            <p class="px-kicker">The problem</p>
            <h2 id="problem-title">Stop rebuilding context.<br>Start where you left off.</h2>
            <p>Your work lives across conversations, documents, ideas and half-made decisions. Before AI help becomes useful, you often have to rebuild the background: what the project is, what you already decided, what changed since last week.</p>
            <p>Aqua is designed to carry that context forward, so each conversation can begin where the last one ended.</p>
          </div>

          <%# A diagram of the idea, not a product screenshot and not a claim
              about any other assistant: the same week, told two ways. %>
          <div class="px-split px-reveal" role="group" aria-label="The same week, two ways of working">
            <div class="px-split-col">
              <p class="px-split-label">Starting over each time</p>
              <ol class="px-week">
                <li><span class="px-day">Mon</span><span class="px-chips"><span class="px-chip is-repeat">Explain the project</span><span class="px-chip">Ask</span></span></li>
                <li><span class="px-day">Wed</span><span class="px-chips"><span class="px-chip is-repeat">Explain it again</span><span class="px-chip">Ask</span></span></li>
                <li><span class="px-day">Fri</span><span class="px-chips"><span class="px-chip is-repeat">Explain it again, plus what changed</span><span class="px-chip">Ask</span></span></li>
              </ol>
              <p class="px-split-note">The background is rebuilt every time.</p>
            </div>
            <div class="px-split-col is-aqua">
              <p class="px-split-label">Carrying context forward, with Aqua</p>
              <ol class="px-week is-thread">
                <li><span class="px-day">Mon</span><span class="px-chips"><span class="px-chip is-carry">Tell Aqua about the project</span><span class="px-chip">Ask</span></span></li>
                <li><span class="px-day">Wed</span><span class="px-chips"><span class="px-chip">Ask</span><span class="px-chip-note">the background is already there</span></span></li>
                <li><span class="px-day">Fri</span><span class="px-chips"><span class="px-chip is-carry">Correct one detail</span><span class="px-chip">Ask</span></span></li>
              </ol>
              <p class="px-split-note">The background builds up, and stays yours to correct.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 4 · MEET AQUA AI — what it does today ═══ -->
      <section class="px-lp-sec" id="aqua" aria-labelledby="aqua-title">
        <div class="px-container">
          <div class="px-lp-head px-reveal">
            <p class="px-kicker">The product</p>
            <h2 id="aqua-title">Meet Aqua AI.</h2>
            <p>Aqua AI is a personal thinking system from AQUIPLEX. Tell it what you&rsquo;re working on, share the documents that matter, and it uses that context in later conversations &mdash; so the help you get fits your goals, your work and your decisions.</p>
          </div>

          <ul class="px-uses px-reveal" aria-label="What you can do with Aqua AI today">
            <li class="px-use">
              <span class="px-use-num" aria-hidden="true">01</span>
              <h3>Pick up where you left off</h3>
              <p>Tell Aqua about a project once: what it is, where it stands, what you&rsquo;ve decided. Later conversations start from that, not from zero.</p>
            </li>
            <li class="px-use">
              <span class="px-use-num" aria-hidden="true">02</span>
              <h3>Work with your documents</h3>
              <p>Attach a deck, a spec or your notes and ask about them. What Aqua learns from a file stays linked to the file it came from.</p>
            </li>
            <li class="px-use">
              <span class="px-use-num" aria-hidden="true">03</span>
              <h3>Think a decision through</h3>
              <p>Lay out the options and talk through the trade-offs with an assistant that already has the background.</p>
            </li>
            <li class="px-use">
              <span class="px-use-num" aria-hidden="true">04</span>
              <h3>Organize plans and priorities</h3>
              <p>Turn scattered ideas into a plan, decide what matters this week, and come back to it later without re-explaining.</p>
            </li>
          </ul>

          <div class="px-showcase">
            <div class="px-showcase-copy px-reveal">
              <h3>See what Aqua has learned.</h3>
              <p>Everything Aqua remembers sits on one page, written as plain sentences. Each item shows where it came from &mdash; a conversation, a document, or a correction you made.</p>
              <p>Fix a detail and the new version is used from then on. Forget one item, or everything, whenever you like.</p>
            </div>

            <%# Mirrors the structure and labels of the real Memory page
                (aqua-frontend/src/pages/MemoryPage.tsx: "What AQUA remembers",
                sourceLabel()). The facts themselves are examples, and the
                caption says so. %>
            <figure class="px-mem px-reveal">
              <div class="px-mem-panel">
                <div class="px-mem-head">
                  <div>
                    <p class="px-mem-eyebrow">Yours</p>
                    <p class="px-mem-title">What AQUA remembers</p>
                  </div>
                  <span class="px-mem-count">3 things</span>
                </div>
                <div class="px-mem-row">
                  <p class="px-mem-fact">You&rsquo;re building a budgeting app for university students.</p>
                  <p class="px-mem-meta"><span>From a conversation</span><span class="px-mem-actions" aria-hidden="true">Correct &middot; Forget</span></p>
                </div>
                <div class="px-mem-row">
                  <p class="px-mem-fact">The beta launch is planned for March, not February.</p>
                  <p class="px-mem-meta"><span class="is-corrected">You corrected this</span><span class="px-mem-actions" aria-hidden="true">Correct &middot; Forget</span></p>
                </div>
                <div class="px-mem-row">
                  <p class="px-mem-fact">The goal for the beta is 500 active users.</p>
                  <p class="px-mem-meta"><span>From launch-plan.pdf</span><span class="px-mem-actions" aria-hidden="true">Correct &middot; Forget</span></p>
                </div>
              </div>
              <figcaption>Illustration of Aqua&rsquo;s Memory page. The entries are examples.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- ═══ 5 · HOW AQUA HELPS — today, and the direction ═══ -->
      <section class="px-lp-sec" id="how" aria-labelledby="how-title">
        <div class="px-container">
          <div class="px-lp-head px-reveal">
            <p class="px-kicker">How Aqua helps</p>
            <h2 id="how-title">Your context in. More relevant help out.</h2>
            <p>The idea is simple: the more relevant context an assistant has, the less you have to explain and the more useful its help can be. Here is what that means today, and where we are taking it.</p>
          </div>

          <div class="px-how-group px-reveal">
            <p class="px-how-label is-today">Available today</p>
            <div class="px-how-grid">
              <div class="px-how-item">
                <h3>Context that carries forward</h3>
                <p>What you share in one conversation can inform the next, so you spend less time re-explaining and more time on the question itself.</p>
              </div>
              <div class="px-how-item">
                <h3>Assistance shaped around you</h3>
                <p>Aqua uses what it knows about your goals and situation to make answers more relevant &mdash; and it only uses what you have told it or uploaded.</p>
              </div>
              <div class="px-how-item">
                <h3>Better thinking and planning</h3>
                <p>Explore ideas, weigh trade-offs and organize priorities with your background already part of the conversation.</p>
              </div>
            </div>
          </div>

          <div class="px-how-group px-reveal">
            <p class="px-how-label is-next">Where we&rsquo;re heading</p>
            <div class="px-how-grid is-next">
              <div class="px-how-item">
                <h3>An understanding that develops</h3>
                <p>We are working toward an Aqua that maintains a richer, continuously updated picture of your world &mdash; not only a record of what was said.</p>
              </div>
              <div class="px-how-item">
                <h3>Help that comes to you</h3>
                <p>The aim is assistance that brings up what matters &mdash; an open decision, a plan that has drifted &mdash; before you think to ask.</p>
              </div>
              <div class="px-how-item">
                <h3>More of your digital world</h3>
                <p>Today Aqua knows only what you share with it directly. Over time, we want it to understand more of where your work lives &mdash; always on your terms.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 6 · CONTROL ═══ -->
      <section class="px-lp-sec" aria-labelledby="control-title">
        <div class="px-container">
          <div class="px-lp-head px-reveal">
            <p class="px-kicker">Your control</p>
            <h2 id="control-title">Personal, without being opaque.</h2>
          </div>
          <div class="px-ctrl px-reveal">
            <div class="px-ctrl-item">
              <h3>You choose what it knows.</h3>
              <p>Aqua learns from your conversations with it and the files you upload. It does not read your email, chat tools or code hosts.</p>
            </div>
            <div class="px-ctrl-item">
              <h3>You can see where things came from.</h3>
              <p>Each thing Aqua remembers shows its source, so you can check the evidence rather than take the conclusion on trust.</p>
            </div>
            <div class="px-ctrl-item">
              <h3>You can change or delete it.</h3>
              <p>Correct a detail and the correction holds in later conversations. Forget one item, or all of it, from a single page.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 7 · THE COMPANY ═══ -->
      <section class="px-lp-sec px-company" id="company" aria-labelledby="company-title">
        <div class="px-container">
          <div class="px-lp-head px-reveal">
            <p class="px-kicker">AQUIPLEX</p>
            <h2 id="company-title">The company behind Aqua.</h2>
          </div>
          <dl class="px-vm px-reveal">
            <div class="px-vm-item">
              <dt>Our vision</dt>
              <dd>Build the world&rsquo;s most context-aware AI.</dd>
            </div>
            <div class="px-vm-item">
              <dt>Our mission</dt>
              <dd>Create AI that truly understands your digital world.</dd>
            </div>
          </dl>
          <div class="px-company-body px-reveal">
            <p>Most AI responds to the prompt in front of it. We believe the more useful assistant is one that develops &mdash; carefully, and on your terms &mdash; an understanding of the context around that prompt: your work, your goals, and the decisions you have already made.</p>
            <p>Aqua AI is where we pursue that idea in practice. We are early, and we would rather show you what Aqua does today than overstate it.</p>
            <a href="/about" class="px-link px-link-arrow">More about AQUIPLEX</a>
          </div>
        </div>
      </section>

      <!-- ═══ 8 · QUESTIONS ═══ -->
      <section class="px-lp-sec" aria-labelledby="faq-title">
        <div class="px-container">
          <div class="px-lp-head px-reveal">
            <h2 id="faq-title">Questions.</h2>
          </div>
          <div class="px-faq px-reveal">
            <details>
              <summary>What is the difference between AQUIPLEX and Aqua AI?</summary>
              <p>AQUIPLEX is the company. Aqua AI is the product we build: a personal thinking system you can use on Android and on the web.</p>
            </details>
            <details>
              <summary>What does Aqua actually learn from?</summary>
              <p>The conversations you have with it, and the files you give it. Something you said in chat and something a document says can support or contradict each other &mdash; and either way you can see which conversation or which file it came from.</p>
            </details>
            <details>
              <summary>Can I see and delete what it knows about me?</summary>
              <p>Yes. Everything sits on one page, written as sentences rather than raw records, with where each item came from. You can correct one, forget one, or forget all of it.</p>
            </details>

            <%# BLOCKED - TRAINING QUESTION. Do not ship without this.
                A page that asks people to hand over their files and their
                conversations must answer "is my work used to train models?"
                in plain language; its absence is louder than its presence.
                Awaiting the true answer - nothing is guessed here. Restore
                by pasting a <details> block in this position. %>

            <details>
              <summary>Where can I use Aqua AI?</summary>
              <p>On Android, through <a href="<%= PLAY_STORE_URL %>" class="px-link-inline" target="_blank" rel="noopener noreferrer">Google Play</a>, and in your browser on the web. Both use the same account.</p>
            </details>
            <details>
              <summary>What does it cost?</summary>
              <p>You can start free, with free credits every day and no card required. Prepaid credit packs are there if you need more, and purchased credits do not expire. <a href="/pricing" class="px-link-inline">See pricing</a>.</p>
            </details>
          </div>
        </div>
      </section>

      <!-- ═══ 9 · CLOSE ═══ -->
      <section class="px-close" aria-labelledby="close-title">
        <div class="px-container px-reveal">
          <img src="/logo/aqua-ai-192.png" alt="Aqua AI" width="72" height="72" class="px-close-mark">
          <h2 id="close-title">Meet Aqua AI.</h2>
          <p>A more personal approach to AI assistance &mdash; one that starts where you left off.</p>
          <div class="px-close-ctas">
            <a href="<%= PLAY_STORE_URL %>" class="px-btn px-btn-primary px-btn-lg px-dl" target="_blank" rel="noopener noreferrer" aria-label="Download Aqua AI on Google Play (opens in a new tab)">
              <svg class="px-dl-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="px-dl-label"><span>Download Aqua AI</span><span class="px-dl-sub">Android &middot; Google Play</span></span>
            </a>
            <a href="/signup" class="px-link px-link-arrow">Use Aqua on the web</a>
          </div>
        </div>
      </section>

    </main>

    <%- include("partials/footer") %>

    <script>
      /* Section entry: fade + small rise, once. The hidden state lives under
         html.js (set in the nav partial before anything paints), so a visitor
         whose JavaScript never runs gets the complete page. */
      (function () {
        var els = document.querySelectorAll('.px-reveal');
        if (!('IntersectionObserver' in window)) {
          for (var i = 0; i < els.length; i++) els[i].classList.add('in');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
      })();
    </script>
  </body>
</html>
